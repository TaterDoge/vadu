{
  "name": "vadu",
  "version": "1.0.0",
  "description": "桌面翻译软件",
  "author": "vadu",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "bun run typecheck && electron-vite build",
    "build:linux": "bun run build && electron-builder --linux",
    "build:mac": "bun run build && electron-builder --mac",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "dev": "electron-vite dev",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "start": "electron-vite preview",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "fix": "ultracite fix",
    "check": "ultracite check",
    "check-fix": "bun run typecheck && bun run fix",
    "test": "bun test"
  },
  "dependencies": {
    "@animate-ui/react": "^2.3.0",
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-hotkeys": "^0.16.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "ultracite": "8.0.1",
    "vite": "^8.3.4"
  }
}
