{
  "apiVersion": 2,
  "id": "vadu.ai",
  "name": "AI 翻译",
  "version": "0.1.0",
  "kind": "translator",
  "main": "index.js",
  "description": "通过任意 OpenAI 兼容端点做翻译",
  "author": "vadu",
  "capabilities": {
    "glossary": true,
    "models": true,
    "streaming": true
  },
  "permissions": ["net:*"],
  "config": {
    "type": "object",
    "required": ["baseURL", "model", "apiKey"],
    "properties": {
      "protocol": {
        "type": "string",
        "title": "协议",
        "description": "OpenAI 兼容端点占绝大多数；Anthropic 与 Gemini 原生协议支持各自的专有能力",
        "enum": ["openai", "anthropic", "gemini"],
        "enumLabels": ["OpenAI 兼容", "Anthropic", "Gemini"],
        "default": "openai"
      },
      "baseURL": {
        "type": "string",
        "title": "接口地址 (Base URL)",
        "placeholder": "https://api.openai.com/v1",
        "required": true
      },
      "apiKey": {
        "type": "secret",
        "title": "API Key",
        "required": true
      },
      "model": {
        "type": "string",
        "title": "模型",
        "placeholder": "gpt-4.1-mini",
        "required": true
      },
      "temperature": {
        "type": "number",
        "title": "温度",
        "description": "留空使用默认 0.3，越低越稳定",
        "minimum": 0,
        "maximum": 2,
        "step": 0.1,
        "x-advanced": true
      },
      "extra": {
        "type": "json",
        "title": "提供商选项",
        "description": "厂商特有参数，原样并入请求体；与核心字段冲突时核心字段优先",
        "x-advanced": true
      },
      "headers": {
        "type": "json",
        "title": "请求头",
        "description": "自定义请求头；authorization、content-type、cookie 等保留头会被忽略",
        "x-advanced": true
      }
    }
  },
  "presets": [
    {
      "id": "openai",
      "label": "OpenAI",
      "config": {
        "baseURL": "https://api.openai.com/v1",
        "model": "gpt-4.1-mini"
      },
      "models": ["gpt-4.1-mini", "gpt-4o-mini"]
    },
    {
      "id": "anthropic",
      "label": "Anthropic",
      "config": {
        "protocol": "anthropic",
        "baseURL": "https://api.anthropic.com/v1",
        "model": "claude-sonnet-4-5"
      },
      "models": ["claude-sonnet-4-5", "claude-opus-4-1", "claude-haiku-4-5"]
    },
    {
      "id": "gemini",
      "label": "Google Gemini",
      "config": {
        "protocol": "gemini",
        "baseURL": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemini-2.5-flash"
      },
      "models": ["gemini-2.5-flash", "gemini-2.5-pro"]
    },
    {
      "id": "deepseek",
      "label": "DeepSeek",
      "config": {
        "baseURL": "https://api.deepseek.com/v1",
        "model": "deepseek-chat"
      },
      "models": ["deepseek-chat", "deepseek-reasoner"]
    },
    {
      "id": "moonshot",
      "label": "Moonshot / Kimi",
      "config": {
        "baseURL": "https://api.moonshot.cn/v1",
        "model": "moonshot-v1-8k"
      },
      "models": ["moonshot-v1-8k", "moonshot-v1-32k"]
    },
    {
      "id": "ollama",
      "label": "本地 Ollama",
      "config": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "model": "qwen3:8b"
      },
      "models": []
    }
  ]
}
