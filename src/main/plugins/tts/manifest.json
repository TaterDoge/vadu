{
  "apiVersion": 2,
  "id": "vadu.tts",
  "name": "AI 朗读",
  "version": "0.1.0",
  "kind": "tts",
  "main": "index.js",
  "description": "通过 OpenAI 兼容端点将文本合成为语音",
  "author": "vadu",
  "capabilities": {},
  "permissions": ["net:*"],
  "config": {
    "type": "object",
    "required": ["baseURL", "apiKey", "voice"],
    "properties": {
      "baseURL": {
        "type": "string",
        "title": "接口地址 (Base URL)",
        "placeholder": "https://api.openai.com/v1",
        "required": true
      },
      "apiKey": {
        "type": "secret",
        "title": "API Key",
        "required": true
      },
      "model": {
        "type": "string",
        "title": "模型",
        "default": "tts-1"
      },
      "voice": {
        "type": "string",
        "title": "音色",
        "enum": ["alloy", "echo", "fable", "onyx", "nova", "shimmer"],
        "default": "alloy",
        "required": true
      },
      "format": {
        "type": "string",
        "title": "输出格式",
        "enum": ["mp3", "wav"],
        "default": "mp3",
        "x-advanced": true
      },
      "speed": {
        "type": "number",
        "title": "语速",
        "minimum": 0.25,
        "maximum": 4,
        "step": 0.05,
        "x-advanced": true
      }
    }
  },
  "presets": [
    {
      "id": "openai",
      "label": "OpenAI",
      "config": {
        "baseURL": "https://api.openai.com/v1",
        "model": "tts-1",
        "voice": "alloy"
      }
    }
  ]
}
